# ============================================================
# Streamlit Secrets 模板
# ============================================================
# 1. 在本地开发时，把本文件复制为 .streamlit/secrets.toml
# 2. 在 Streamlit Cloud 部署时，把敏感字段填到
#    App settings → Secrets (TOML 格式) 即可
# 3. 切勿把真实 secrets 提交到 Git！

# ---------- 备用 Fuseki SPARQL endpoint（可选） ----------
# 若启用远端 Fuseki，则会覆盖本地 ontology.json
# FUSEKI_ENDPOINT = "https://your-fuseki-host/dataset/query"
# FUSEKI_USER     = "admin"
# FUSEKI_PASSWORD = "your_password"

# ---------- 第三方 API key（如有需要可放这里） ----------
# OPENAI_API_KEY   = "sk-..."
# HF_API_TOKEN     = "hf_..."

# ---------- 业务配置 ----------
APP_NAME = "C-UAS Ontology Demo"
APP_OWNER = "C-UAS Ontology Group · OSREDM 2026"
