{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuas-ontology.org/schema/action-contract-1.0.json",
  "title": "C-UAS 运行态 Action 契约",
  "type": "object",
  "required": ["schema_version", "decision_id", "before_state", "after_state", "actions"],
  "properties": {
    "schema_version": {"const": 1},
    "decision_id": {"type": "string", "pattern": "^ACT-[A-F0-9]{12}$"},
    "before_state": {"type": "object", "required": ["mission_id", "revision"]},
    "after_state": {"type": "object", "required": ["mission_id", "revision"]},
    "actions": {
      "type": "array",
      "items": {"$ref": "#/$defs/action"}
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id", "rule_id", "action_code", "description", "execution_status",
        "target_mission", "target_capabilities", "target_equipment", "preconditions",
        "side_effects", "validation_function", "expected_revision", "evidence_refs"
      ],
      "properties": {
        "action_id": {"type": "string", "minLength": 8},
        "rule_id": {"type": "string", "pattern": "^R[0-9]{2}_[A-Z0-9_]+$"},
        "action_code": {
          "enum": [
            "ADJUST_SENSOR_SCAN_MODE", "SWITCH_FUSION_MODEL", "RAISE_MISSION_PRIORITY",
            "AUTHORIZE_RESOURCE_REALLOCATION", "QUARANTINE_AND_RERUN_WTA",
            "AUTHORIZE_BATCH_DECISION_MODE", "AUTHORIZE_EFFECTOR_REINFORCEMENT",
            "RAISE_FUSION_CONFIRMATION"
          ]
        },
        "description": {"type": "string", "minLength": 4},
        "execution_status": {"enum": ["AUTO_APPLIED", "PENDING_HUMAN_AUTHORIZATION"]},
        "target_mission": {"type": "string", "minLength": 1},
        "target_capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "target_equipment": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "preconditions": {
          "type": "object",
          "required": ["observed", "predicate", "rule_id"],
          "properties": {
            "observed": {},
            "predicate": {"type": "string", "minLength": 1},
            "rule_id": {"type": "string"}
          },
          "additionalProperties": false
        },
        "side_effects": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "validation_function": {"type": "string", "minLength": 4},
        "expected_revision": {"type": "integer", "minimum": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
