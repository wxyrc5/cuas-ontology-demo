###########################################################################
# C-UAS Ontology: 反无人机体系本体模型
# 版本: V1.2 (2026-08)
# 配套研究: 《反无人机体系本体模型技术方案》 第 4 章
#
# 用途:
#   - 描述反无人机体系的 8 个核心 Object Type (Mission, Scenario,
#     TechnicalCapability, Equipment, EffectMetric, Threat, Asset, Operator)
#   - 描述 10 个核心 Link Type (governs, allocates, measuredBy,
#     implements, covers, produces, protects, confronts, validates, operates)
#   - 以 Effect、Signal、SpatiotemporalContext 三个扩展类型和 6 个扩展关系补齐效果、信号与时空语义
#   - 设计态规则以 cuas-rules.swrl 维护；运行态使用物化查询、Action Contract 与确定性规则引擎
#
# 验证工具:
#   - Owlready2 0.51 内置 HermiT（实际执行记录见验证输出）
#   - Apache Jena Fuseki 4.10 (TDB2 存储)
#   - SPARQL 1.1 查询
#
# 作者: 反无人机体系本体模型研究组
# 命名空间: http://cuas-ontology.org/cuas#
###########################################################################

@prefix cuas: <http://cuas-ontology.org/cuas#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
# Ontology 头声明
<http://cuas-ontology.org/cuas> a owl:Ontology ;
    rdfs:label "C-UAS Ontology"@en , "反无人机体系本体"@zh ;
    rdfs:comment "反无人机作战体系本体模型：8 个核心 Object Type、10 个核心 Link Type，加 3 个评审扩展类型与 6 个扩展关系；设计态推理和运行态规则执行分离。"@zh ;
    owl:versionInfo "1.2" .

###########################################################################
# 第 1 部分: 8 个核心 Object Type
###########################################################################



# === 顶层基类（所有领域实体的父类，对应 Palantir Shared Property） ===
cuas:DomainEntity a owl:Class ;
    rdfs:label "领域实体"@zh , "DomainEntity"@en ;
    rdfs:comment "所有 8 个 Object Type 的共同基类"@zh .

cuas:STANAGProfile a owl:Class ;
    rdfs:label "STANAG 剖面"@zh , "STANAG Profile"@en ;
    rdfs:comment "STANAG 4586/4660/4817 等北约标准剖面"@zh .

# === Shared Property (跨 Object Type 复用) ===
cuas:hasId a owl:DatatypeProperty ;
    rdfs:domain cuas:DomainEntity ;
    rdfs:range xsd:string ;
    rdfs:label "唯一标识"@zh .

cuas:hasName a owl:DatatypeProperty ;
    rdfs:domain cuas:DomainEntity ;
    rdfs:range xsd:string ;
    rdfs:label "名称"@zh .

cuas:hasTimestamp a owl:DatatypeProperty ;
    rdfs:domain cuas:DomainEntity ;
    rdfs:range xsd:dateTime ;
    rdfs:label "时间戳"@zh .

cuas:hasGeoLocation a owl:DatatypeProperty ;
    rdfs:domain cuas:DomainEntity ;
    rdfs:range xsd:string ;
    rdfs:label "旧版地理位置字符串"@zh ;
    owl:deprecated true ;
    rdfs:comment "兼容旧实例；新数据应使用 hasSpatiotemporalContext 指向带 CRS、精度和时间戳的复合对象。"@zh .



# === Object Type 1: Mission (使命) ===

cuas:Mission a owl:Class ;
    rdfs:subClassOf cuas:DomainEntity ;
    rdfs:label "反无人机使命"@zh , "Mission"@en ;
    rdfs:comment "反无人机作战使命的语义定义，承载作战意图、保护对象与效果期望。" .

cuas:missionId a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain cuas:Mission ;
    rdfs:range xsd:string .

cuas:missionType a owl:DatatypeProperty ;
    rdfs:domain cuas:Mission ;
    rdfs:range xsd:string ;
    rdfs:comment "类型枚举：Defense（要地防空）/ Escort（要员护送）/ Area-Denial（区域拒止）/ Patrol（常态化巡逻）" .

cuas:priority a owl:DatatypeProperty ;
    rdfs:domain cuas:Mission ;
    rdfs:range xsd:integer ;
    rdfs:comment "1-5，5 为最高优先级" .

cuas:protectedAsset a owl:ObjectProperty ;
    rdfs:domain cuas:Mission ;
    rdfs:range cuas:Asset .

cuas:geoFence a owl:DatatypeProperty ;
    rdfs:domain cuas:Mission ;
    rdfs:range xsd:string ;
    rdfs:comment "责任区 GeoJSON 或 WKT 字符串；几何合法性由 SHACL/应用层校验。"@zh .

cuas:timeWindow a owl:DatatypeProperty ;
    rdfs:domain cuas:Mission ;
    rdfs:range xsd:string ;
    rdfs:comment "ISO 8601 起止时间字符串。"@zh .

cuas:rulesOfEngagement a owl:DatatypeProperty ;
    rdfs:domain cuas:Mission ;
    rdfs:range xsd:string ;
    rdfs:comment "交战规则 ROE，自然语言或受控词表" .

cuas:successCriteria a owl:DatatypeProperty ;
    rdfs:domain cuas:Mission ;
    rdfs:range xsd:string ;
    rdfs:comment "成功判据：拦截成功率≥85% 且 虚警率<2% 等" .

# === Object Type 2: Scenario (工作场景) ===

cuas:Scenario a owl:Class ;
    rdfs:subClassOf cuas:DomainEntity ;
    rdfs:label "工作场景"@zh , "Scenario"@en ;
    rdfs:comment "使命分解出的具体作战阶段与状态。" .

cuas:scenarioId a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain cuas:Scenario ;
    rdfs:range xsd:string .

cuas:scenarioStage a owl:DatatypeProperty ;
    rdfs:domain cuas:Scenario ;
    rdfs:range xsd:string ;
    rdfs:comment "5 阶段枚举：Detection/TrackingIdentification/ThreatAssessment/DecisionAllocation/EngagementVerification" .

cuas:triggerCondition a owl:DatatypeProperty ;
    rdfs:domain cuas:Scenario ;
    rdfs:range xsd:string .

cuas:expectedOutcome a owl:DatatypeProperty ;
    rdfs:domain cuas:Scenario ;
    rdfs:range xsd:string .

cuas:scenarioLatencyBudget a owl:DatatypeProperty ;
    rdfs:domain cuas:Scenario ;
    rdfs:range xsd:decimal ;
    rdfs:comment "阶段时延预算，统一使用秒；例如 0.8 表示 0.8 秒。采用 OWL 2 datatype map 支持的 xsd:decimal，便于 HermiT 严格推理。"@zh .


# === Object Type 3: TechnicalCapability (技术能力) ===

cuas:TechnicalCapability a owl:Class ;
    rdfs:subClassOf cuas:DomainEntity ;
    rdfs:label "技术能力"@zh , "TechnicalCapability"@en ;
    rdfs:comment "装备抽象出的能力谱系，6 大类：探测感知/融合识别/决策指控/软杀伤/硬毁伤/集成使能" .

cuas:capabilityId a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain cuas:TechnicalCapability ;
    rdfs:range xsd:string .

cuas:capabilityClass a owl:DatatypeProperty ;
    rdfs:domain cuas:TechnicalCapability ;
    rdfs:range xsd:string ;
    rdfs:comment "枚举：Detection / FusionID / C2 / SoftKill / HardKill / IntegrationEnablement" .

cuas:capabilityMetric a owl:DatatypeProperty ;
    rdfs:domain cuas:TechnicalCapability ;
    rdfs:range xsd:string ;
    rdfs:comment "能力度量（如探测距离 km、识别准确率）" .

cuas:capabilityVersion a owl:DatatypeProperty ;
    rdfs:domain cuas:TechnicalCapability ;
    rdfs:range xsd:string .

# === Object Type 4: Equipment (装备) ===

cuas:Equipment a owl:Class ;
    rdfs:subClassOf cuas:DomainEntity ;
    rdfs:label "装备"@zh , "Equipment"@en ;
    rdfs:comment "具体装备实例，对应 MOSA/SOSA/CMOSS 模块或具体装备" .

cuas:equipmentSN a owl:DatatypeProperty ;
    rdfs:domain cuas:Equipment ;
    rdfs:range xsd:string .

cuas:stanagProfile a owl:ObjectProperty ;
    rdfs:domain cuas:Equipment ;
    rdfs:range cuas:STANAGProfile ;
    rdfs:comment "满足的标准剖面（STANAG 4586/4660/4817、SAPIENT 等）" .

cuas:operationalStatus a owl:DatatypeProperty ;
    rdfs:domain cuas:Equipment ;
    rdfs:range xsd:string ;
    rdfs:comment "枚举：Available / Engaged / Maintenance / Failed" .

cuas:healthScore a owl:DatatypeProperty ;
    rdfs:domain cuas:Equipment ;
    rdfs:range xsd:double ;
    rdfs:label "健康度"@zh ;
    rdfs:comment "0 到 1 的参数化装备健康度，用于本体条件先验敏感性分析；非现场实测。"@zh .

cuas:geoPosition a owl:DatatypeProperty ;
    rdfs:domain cuas:Equipment ;
    rdfs:range xsd:string ;
    owl:deprecated true ;
    rdfs:comment "兼容旧版坐标字符串；V1.2 起改用 SpatiotemporalContext。"@zh .

# === Object Type 5: EffectMetric (效果指标) ===

cuas:EffectMetric a owl:Class ;
    rdfs:subClassOf cuas:DomainEntity ;
    rdfs:label "效果指标"@zh , "EffectMetric"@en ;
    rdfs:comment "KPP/MOE/MOP 三段式效果度量" .

cuas:metricId a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain cuas:EffectMetric ;
    rdfs:range xsd:string .

cuas:metricName a owl:DatatypeProperty ;
    rdfs:domain cuas:EffectMetric ;
    rdfs:range xsd:string ;
    rdfs:comment "枚举：DetectionCoverage / IdentificationAccuracy / OODAClosureTime / InterceptionSuccessRate / FalseAlarmRate" .

cuas:metricValue a owl:DatatypeProperty ;
    rdfs:domain cuas:EffectMetric ;
    rdfs:range xsd:double .

cuas:metricThreshold a owl:DatatypeProperty ;
    rdfs:domain cuas:EffectMetric ;
    rdfs:range xsd:double .

cuas:metricLayer a owl:DatatypeProperty ;
    rdfs:domain cuas:EffectMetric ;
    rdfs:range xsd:string ;
    rdfs:comment "MOP / MOE / OperationalEffectiveness" .

# === Object Type 6: Threat (威胁) ===

cuas:Threat a owl:Class ;
    rdfs:subClassOf cuas:DomainEntity ;
    rdfs:label "威胁"@zh , "Threat"@en ;
    rdfs:comment "敌方无人机或蜂群目标" .

cuas:threatClass a owl:DatatypeProperty ;
    rdfs:domain cuas:Threat ;
    rdfs:range xsd:string ;
    rdfs:comment "UN 4 类分类：Class I (<25kg LSS) / Class II (25-150kg) / Class III (150-600kg) / Class IV (>600kg)" .

cuas:threatLevel a owl:DatatypeProperty ;
    rdfs:domain cuas:Threat ;
    rdfs:range xsd:integer ;
    rdfs:comment "1-5，威胁等级" .

cuas:threatTrajectory a owl:DatatypeProperty ;
    rdfs:domain cuas:Threat ;
    rdfs:range xsd:string .

cuas:isSwarmMember a owl:DatatypeProperty ;
    rdfs:domain cuas:Threat ;
    rdfs:range xsd:boolean .


# === Object Type 7: Asset (被保护资产) ===

cuas:Asset a owl:Class ;
    rdfs:subClassOf cuas:DomainEntity ;
    rdfs:label "被保护资产"@zh , "Asset"@en .

cuas:assetType a owl:DatatypeProperty ;
    rdfs:domain cuas:Asset ;
    rdfs:range xsd:string ;
    rdfs:comment "枚举：CriticalInfrastructure / VIP / MassEvent / MilitaryAsset" .

cuas:criticalityScore a owl:DatatypeProperty ;
    rdfs:domain cuas:Asset ;
    rdfs:range xsd:integer .


# === Object Type 8: Operator (操作员) ===

cuas:Operator a owl:Class ;
    rdfs:subClassOf cuas:DomainEntity ;
    rdfs:label "操作员"@zh , "Operator"@en .

cuas:operatorRole a owl:DatatypeProperty ;
    rdfs:domain cuas:Operator ;
    rdfs:range xsd:string ;
    rdfs:comment "角色：Commander / SensorOperator / EffectorOperator / Analyst" .

cuas:clearanceLevel a owl:DatatypeProperty ;
    rdfs:domain cuas:Operator ;
    rdfs:range xsd:string .

###########################################################################
# 评审扩展类型：不改变技术方案的 8 个核心业务对象
###########################################################################

cuas:Effect a owl:Class ;
    rdfs:subClassOf cuas:DomainEntity, sosa:Actuation ;
    rdfs:label "实际效果"@zh , "Effect"@en ;
    rdfs:comment "Act 阶段产生的物理或行为效果；与数值度量 EffectMetric 明确区分。"@zh .

cuas:effectType a owl:DatatypeProperty ;
    rdfs:domain cuas:Effect ;
    rdfs:range xsd:string ;
    rdfs:comment "ControlledLinkDenial / NavigationDeception / HPMDisruption / KineticCapture 等受控类型。"@zh .

cuas:effectOutcome a owl:DatatypeProperty ;
    rdfs:domain cuas:Effect ;
    rdfs:range xsd:string ;
    rdfs:comment "Succeeded / Failed / Indeterminate。"@zh .

cuas:effectAt a owl:DatatypeProperty ;
    rdfs:domain cuas:Effect ;
    rdfs:range xsd:dateTime .

cuas:Signal a owl:Class ;
    rdfs:subClassOf cuas:DomainEntity, sosa:ObservableProperty ;
    rdfs:label "信号/通信对象"@zh , "Signal"@en ;
    rdfs:comment "被传感器观测或被效应器作用的遥控、导航、数传或告警链路语义对象。"@zh .

cuas:signalType a owl:DatatypeProperty ;
    rdfs:domain cuas:Signal ;
    rdfs:range xsd:string .

cuas:centerFrequencyHz a owl:DatatypeProperty ;
    rdfs:domain cuas:Signal ;
    rdfs:range xsd:double .

cuas:SpatiotemporalContext a owl:Class ;
    rdfs:subClassOf cuas:DomainEntity, sosa:Observation ;
    rdfs:label "时空上下文"@zh , "SpatiotemporalContext"@en ;
    rdfs:comment "将坐标参考系、WKT 位置、精度、时间戳和速度矢量封装为复合对象。"@zh .

cuas:coordinateReferenceSystem a owl:DatatypeProperty ;
    rdfs:domain cuas:SpatiotemporalContext ;
    rdfs:range xsd:anyURI .

cuas:requiresTransformation a owl:DatatypeProperty ;
    rdfs:domain cuas:SpatiotemporalContext ;
    rdfs:range xsd:boolean ;
    rdfs:label "融合前需要坐标转换"@zh ;
    rdfs:comment "源 CRS 与任务区域目标 CRS 不一致时为 true；运行态转换失败必须阻断融合。"@zh .

cuas:targetCoordinateReferenceSystem a owl:DatatypeProperty ;
    rdfs:domain cuas:SpatiotemporalContext ;
    rdfs:range xsd:anyURI ;
    rdfs:label "任务区域目标坐标参考系"@zh ;
    rdfs:comment "不得全局写死单一 UTM 分区；由任务区域和坐标的适用范围确定。"@zh .

cuas:transformationStatus a owl:DatatypeProperty ;
    rdfs:domain cuas:SpatiotemporalContext ;
    rdfs:range xsd:string ;
    rdfs:label "坐标转换状态"@zh ;
    rdfs:comment "运行态枚举：IDENTITY / TRANSFORMED / REJECTED。"@zh .

cuas:positionWKT a owl:DatatypeProperty ;
    rdfs:domain cuas:SpatiotemporalContext ;
    rdfs:range xsd:string ;
    rdfs:comment "OWL 2/HermiT 可判定层使用 xsd:string；运行态 GeoSPARQL 适配器可映射为 geo:asWKT/geo:wktLiteral。"@zh .

cuas:positionAccuracyM a owl:DatatypeProperty ;
    rdfs:domain cuas:SpatiotemporalContext ;
    rdfs:range xsd:double .

cuas:observedAt a owl:DatatypeProperty ;
    rdfs:domain cuas:SpatiotemporalContext ;
    rdfs:range xsd:dateTime .

cuas:velocityEastMps a owl:DatatypeProperty ;
    rdfs:domain cuas:SpatiotemporalContext ;
    rdfs:range xsd:double .

cuas:velocityNorthMps a owl:DatatypeProperty ;
    rdfs:domain cuas:SpatiotemporalContext ;
    rdfs:range xsd:double .

cuas:velocityUpMps a owl:DatatypeProperty ;
    rdfs:domain cuas:SpatiotemporalContext ;
    rdfs:range xsd:double .

# 8 个核心对象类型语义互斥。该公理使错误的跨类型复用可被 DL 推理器检出。
[] a owl:AllDisjointClasses ;
    owl:members (
        cuas:Mission
        cuas:Scenario
        cuas:TechnicalCapability
        cuas:Equipment
        cuas:EffectMetric
        cuas:Threat
        cuas:Asset
        cuas:Operator
    ) .


###########################################################################
# 第 2 部分: 10 个核心 Link Type (OWL ObjectProperty)
###########################################################################

# === Link Type 1: governs (使命 → 场景) ===

cuas:governs a owl:ObjectProperty ;
    rdfs:domain cuas:Mission ;
    rdfs:range cuas:Scenario ;
    rdfs:label "支配"@zh , "governs"@en ;
    rdfs:comment "一张 Mission 卡可支配多个 Scenario 阶段" .

cuas:measuredBy a owl:ObjectProperty ;
    rdfs:domain cuas:Mission ;
    rdfs:range cuas:EffectMetric ;
    rdfs:label "由…度量"@zh , "measuredBy"@en ;
    rdfs:comment "MOP/MOE/KPP 三段式度量使命成功" .

cuas:validates a owl:ObjectProperty ;
    rdfs:domain cuas:EffectMetric ;
    rdfs:range cuas:Mission ;
    rdfs:label "反哺"@zh , "validates"@en ;
    owl:inverseOf cuas:measuredBy ;
    rdfs:comment "Effect 反哺 Mission，闭环反馈" .

cuas:confronts a owl:ObjectProperty ;
    rdfs:domain cuas:Mission ;
    rdfs:range cuas:Threat ;
    rdfs:label "对抗"@zh , "confronts"@en .

cuas:protects a owl:ObjectProperty ;
    rdfs:domain cuas:Mission ;
    rdfs:range cuas:Asset ;
    rdfs:label "保护"@zh , "protects"@en .


# === Link Type 2: allocates (使命 → 技术方案/能力) ===
cuas:allocates a owl:ObjectProperty ;
    rdfs:domain cuas:Mission ;
    rdfs:range cuas:TechnicalCapability ;
    rdfs:label "分配"@zh , "allocates"@en ;
    rdfs:comment "使命分配技术方案；本模型以 TechnicalCapability 承载 Solution 语义。"@zh .

# === Link Type 4: implements (装备 → 能力) ===
cuas:implements a owl:ObjectProperty ;
    rdfs:domain cuas:Equipment ;
    rdfs:range cuas:TechnicalCapability ;
    rdfs:label "实现"@zh , "implements"@en ;
    rdfs:comment "装备实现技术能力，MANY→MANY"@zh .

# === Link Type 5: covers (装备 → 场景) ===
cuas:covers a owl:ObjectProperty ;
    rdfs:domain cuas:Equipment ;
    rdfs:range cuas:Scenario ;
    rdfs:label "涵盖"@zh , "covers"@en ;
    rdfs:comment "装备覆盖一个或多个场景阶段，MANY→MANY。"@zh .

# === Link Type 6: produces (技术方案/能力 → 效果) ===
cuas:produces a owl:ObjectProperty ;
    rdfs:domain cuas:TechnicalCapability ;
    rdfs:range cuas:EffectMetric ;
    rdfs:label "产出"@zh , "produces"@en ;
    rdfs:comment "技术方案/能力产出效果指标。"@zh .

# === Link Type 10: operates (操作员 → 装备) ===
cuas:operates a owl:ObjectProperty ;
    rdfs:domain cuas:Operator ;
    rdfs:range cuas:Equipment ;
    rdfs:label "操作"@zh , "operates"@en ;
    rdfs:comment "操作员操作装备，MANY→MANY"@zh .

# === 6 个评审扩展关系 ===
cuas:hasSpatiotemporalContext a owl:ObjectProperty ;
    rdfs:domain cuas:DomainEntity ;
    rdfs:range cuas:SpatiotemporalContext ;
    rdfs:label "具有时空上下文"@zh .

cuas:emitsSignal a owl:ObjectProperty ;
    rdfs:domain cuas:Threat ;
    rdfs:range cuas:Signal ;
    rdfs:label "发射信号"@zh .

cuas:observesSignal a owl:ObjectProperty ;
    rdfs:domain cuas:Equipment ;
    rdfs:range cuas:Signal ;
    rdfs:label "观测信号"@zh .

cuas:causesEffect a owl:ObjectProperty ;
    rdfs:domain cuas:Equipment ;
    rdfs:range cuas:Effect ;
    rdfs:label "产生实际效果"@zh .

cuas:affectsThreat a owl:ObjectProperty ;
    rdfs:domain cuas:Effect ;
    rdfs:range cuas:Threat ;
    rdfs:label "作用于威胁"@zh .

cuas:quantifiedBy a owl:ObjectProperty ;
    rdfs:domain cuas:Effect ;
    rdfs:range cuas:EffectMetric ;
    rdfs:label "由指标量化"@zh .



# === OODA 反向关系 ===

cuas:derivedFrom a owl:ObjectProperty ;
    rdfs:domain cuas:EffectMetric ;
    rdfs:range cuas:Scenario ;
    rdfs:label "由…产生"@zh ;
    rdfs:comment "效果指标由场景产生，支持 Effect→validates→Mission 反馈环" .

# 使命至少关联一个场景、一个技术方案和一个效果指标；开放世界下缺失显式值
# 不会被误判为不一致，但 HermiT 会验证这些限制本身是否可满足。
cuas:Mission rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty cuas:governs ;
      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass cuas:Scenario
    ],
    [ a owl:Restriction ;
      owl:onProperty cuas:allocates ;
      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass cuas:TechnicalCapability
    ],
    [ a owl:Restriction ;
      owl:onProperty cuas:measuredBy ;
      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass cuas:EffectMetric
    ] .


###########################################################################
# 第 3 部分: 规则与实例数据分离声明
###########################################################################

# 4 类自适应规则保存在同目录 `cuas-rules.swrl`，一致的示例实例保存在
# `cuas-data-valid.ttl`。规则和实例不混入 TBox，从而保证本文件可被标准
# OWL 2 DL 工具直接解析、复用与分类。

###########################################################################
# 文档结束
###########################################################################
# 验证步骤:
#  1. 用 Protégé 5.6 打开本文件
#  2. 运行 HermiT 推理器,检查一致性
#  3. 运行 DL 查询验证分类层次
#  4. 导入 Apache Jena Fuseki,执行 SPARQL 1.1 查询
###########################################################################
